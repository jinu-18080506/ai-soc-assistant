# Copy this file to .env and fill it in. Never commit .env (it holds your keys).

# AI provider (any OpenAI-compatible API; the default below is Google Gemini)
AI_API_KEY=
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
AI_MODEL=

# Telegram notifications (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Only alerts at or above this rule level are sent (8 = High and Critical)
NOTIFY_MIN_LEVEL=8
